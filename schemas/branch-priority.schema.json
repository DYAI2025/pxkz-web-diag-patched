{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelkiez.local/schemas/branch-priority.schema.json",
  "title": "Pixelkiez customer-only industry priority context",
  "$defs": {
    "weights": {
      "type": "object", "additionalProperties": false,
      "required": ["findability_seo", "performance_technology", "ux_conversion", "accessibility", "trust_privacy_content", "ai_readiness"],
      "properties": {
        "findability_seo": {"type": "integer", "minimum": 0, "maximum": 100},
        "performance_technology": {"type": "integer", "minimum": 0, "maximum": 100},
        "ux_conversion": {"type": "integer", "minimum": 0, "maximum": 100},
        "accessibility": {"type": "integer", "minimum": 0, "maximum": 100},
        "trust_privacy_content": {"type": "integer", "minimum": 0, "maximum": 100},
        "ai_readiness": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "status", "purpose", "profiles"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "status": {"enum": ["NO_APPROVED_PROFILES_REGISTERED", "APPROVED_PROFILES_REGISTERED"]},
        "purpose": {"type": "string", "minLength": 15},
        "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "industry_id", "business_model_id", "status", "effective_from", "effective_until", "source_ref", "basis", "approved_by", "category_weights"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "industry_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "business_model_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "status": {"enum": ["APPROVED", "DRAFT", "REVOKED"]},
        "effective_from": {"type": "string", "format": "date"},
        "effective_until": {"type": "string", "format": "date"},
        "source_ref": {"type": "string", "minLength": 3},
        "basis": {"enum": ["PIXELKIEZ_PRODUCT_POLICY", "SUPPORTED_MARKET_RESEARCH"]},
        "approved_by": {"type": "string", "minLength": 2},
        "category_weights": {"$ref": "#/$defs/weights"},
        "goal_weights": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"}, "additionalProperties": {"$ref": "#/$defs/weights"}}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "industry_id", "business_model_id", "identity", "audit_date"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "industry_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "business_model_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "audit_date": {"type": "string", "format": "date"},
        "identity": {
          "type": "object", "additionalProperties": false,
          "required": ["evidence_kind", "evidence_ref"],
          "properties": {
            "evidence_kind": {"enum": ["FIRST_PARTY_PUBLIC", "OWNER_CONFIRMED"]},
            "evidence_ref": {"type": "string", "minLength": 3}
          }
        },
        "goal": {
          "type": "object", "additionalProperties": false,
          "required": ["goal_id", "source", "evidence_ref"],
          "properties": {
            "goal_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
            "source": {"const": "OWNER_CONFIRMED"},
            "evidence_ref": {"type": "string", "minLength": 3}
          }
        },
        "roles": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["finding_id", "role", "axis", "evidence_refs", "business_mechanism"],
            "properties": {
              "finding_id": {"type": "string", "minLength": 3},
              "role": {"enum": ["BUSINESS_GAP", "PREMIUM_OPPORTUNITY", "PRECISION_DEMONSTRATION"]},
              "axis": {"enum": ["TECHNICAL", "VISUAL", "BOTH"]},
              "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "business_mechanism": {"type": "string", "minLength": 15, "maxLength": 300}
            }
          }
        }
      }
    }
  }
}
