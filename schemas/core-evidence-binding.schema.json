{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelkiez.local/schemas/core-evidence-binding.schema.json",
  "title": "Pixelkiez Active Core Evidence Binding Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "activation_mode",
    "measurement_registry_version",
    "score_anchor_source",
    "metrics"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "activation_mode": {
      "const": "ACTIVE_CORE_ADMISSION"
    },
    "measurement_registry_version": {
      "type": "string",
      "minLength": 1
    },
    "score_anchor_source": {
      "const": "assets/measurement-registry.json#metric_score_scale"
    },
    "metrics": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "category",
        "metric_weight",
        "category_weight",
        "score_mode",
        "allowed_score_statuses",
        "threshold_source_required",
        "defined_test_method",
        "control_basis",
        "capability_id",
        "source_family",
        "accepted_source_families",
        "required_evidence",
        "maximum_evidence_grade",
        "expected_value_type",
        "target_binding_policy",
        "normalization_path",
        "score_admission_requirements",
        "non_execution_reason_codes"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{2}$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "metric_weight": {
          "type": "number",
          "minimum": 0
        },
        "category_weight": {
          "type": "number",
          "minimum": 0
        },
        "score_mode": {
          "type": "string",
          "minLength": 1
        },
        "allowed_score_statuses": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "strong",
              "minor_gaps",
              "mixed",
              "weak",
              "blocking"
            ]
          }
        },
        "threshold_source_required": {
          "type": "boolean"
        },
        "defined_test_method": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "source_family": {
          "enum": [
            "PUBLIC_DETERMINISTIC_TECHNICAL",
            "MEASUREMENT_GATEWAY",
            "BROWSER_RENDERING",
            "PERFORMANCE_CWV_LAB",
            "SEARCH_INDEXING_SERP",
            "ANALYTICS_SEARCH_CONSOLE",
            "STRUCTURED_CONTENT_DOM_METADATA",
            "RULE_BASED_QUALITATIVE_OBSERVATION",
            "MANUAL_OR_NON_AUTOMATABLE"
          ]
        },
        "accepted_source_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceFamily"
          }
        },
        "required_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scoreable_execution_states",
            "minimum_evidence_refs",
            "missing_evidence_behavior"
          ],
          "properties": {
            "scoreable_execution_states": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "MEASURED",
                  "OBSERVED"
                ]
              }
            },
            "minimum_evidence_refs": {
              "const": 1
            },
            "missing_evidence_behavior": {
              "const": "NOT_SCORE_ADMITTED"
            }
          }
        },
        "maximum_evidence_grade": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4",
            "E5",
            "E6"
          ]
        },
        "expected_value_type": {
          "const": "object"
        },
        "target_binding_policy": {
          "const": "SAME_AUDIT_TARGET"
        },
        "normalization_path": {
          "const": "CORE_EXECUTION_BUNDLE_V1_TO_DIAGNOSIS_METRIC"
        },
        "score_admission_requirements": {
          "type": "array",
          "minItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_execution_reason_codes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "EVIDENCE_UNAVAILABLE",
              "EXECUTION_ERROR",
              "EVIDENCE_CONFLICT",
              "TARGET_MISMATCH",
              "NOT_APPLICABLE",
              "THRESHOLD_SOURCE_MISSING",
              "EVIDENCE_GRADE_TOO_WEAK",
              "VALUE_TYPE_INVALID",
              "RAW_PROVIDER_EVIDENCE_REJECTED"
            ]
          }
        },
        "control_basis": {
          "enum": [
            "PIXELKIEZ_PRODUCT_RUBRIC",
            "CURRENT_PRIMARY_SOURCE_AT_RUNTIME",
            "PUBLIC_REPRODUCIBLE",
            "PUBLIC_SEARCH_SAMPLE",
            "PRESENCE_CHECK_ONLY",
            "VENDOR_TOOL_SIGNAL"
          ]
        }
      }
    },
    "sourceFamily": {
      "enum": [
        "PUBLIC_DETERMINISTIC_TECHNICAL",
        "MEASUREMENT_GATEWAY",
        "BROWSER_RENDERING",
        "PERFORMANCE_CWV_LAB",
        "SEARCH_INDEXING_SERP",
        "ANALYTICS_SEARCH_CONSOLE",
        "STRUCTURED_CONTENT_DOM_METADATA",
        "RULE_BASED_QUALITATIVE_OBSERVATION",
        "MANUAL_OR_NON_AUTOMATABLE"
      ]
    }
  }
}
