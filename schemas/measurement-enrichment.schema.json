{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelkiez.local/schemas/measurement-enrichment.schema.json",
  "title": "Pixelkiez Optional Measurement Enrichment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_url", "generated_at", "mode", "sources", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target_url": {"type": "string", "pattern": "^https?://"},
    "generated_at": {"type": "string", "minLength": 1},
    "mode": {"enum": ["LIVE", "FIXTURE", "OFFLINE", "MIXED"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "status", "note"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "status": {"enum": ["AVAILABLE", "NOT_CONFIGURED", "UNAVAILABLE", "ERROR", "NOT_APPLICABLE"]},
          "note": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "family", "label", "status", "measurement_class", "value", "unit", "source_type", "source_provider", "observed_at", "evidence_ref", "claim_boundary", "manual_review_required", "legal_review_required", "context"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "family": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "status": {"enum": ["MEASURED", "OBSERVED", "NOT_CONFIGURED", "UNAVAILABLE", "ERROR", "NOT_APPLICABLE"]},
          "measurement_class": {"enum": ["measured", "observed", "not_assessed"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "source_type": {"enum": ["PUBLIC_API", "AUTHORIZED_API", "PAID_SERP_API", "PUBLIC_BROWSER", "AUTHORIZED_EXPORT", "FIXTURE_REPLAY"]},
          "source_provider": {"type": "string", "minLength": 1},
          "observed_at": {"type": ["string", "null"]},
          "date_range": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
          },
          "url": {"type": ["string", "null"]},
          "query": {"type": ["string", "null"]},
          "market": {"type": ["string", "null"]},
          "location": {"type": ["string", "null"]},
          "device": {"type": ["string", "null"]},
          "evidence_ref": {"type": "string", "minLength": 1},
          "claim_boundary": {"type": "string", "minLength": 1},
          "manual_review_required": {"type": "boolean"},
          "legal_review_required": {"type": "boolean"},
          "context": {"type": "object"}
        }
      }
    }
  }
}
