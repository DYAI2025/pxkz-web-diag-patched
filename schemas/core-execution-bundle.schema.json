{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelkiez.local/schemas/core-execution-bundle.schema.json",
  "title": "Pixelkiez Active Core Execution Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_contract_version", "target_url", "execution_run_id", "mode", "generated_at", "evidence_catalog", "results"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "binding_contract_version": {"const": "1.0.0"},
    "target_url": {"type": "string", "pattern": "^https?://"},
    "execution_run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["LIVE", "FIXTURE", "REPLAY"]},
    "generated_at": {"type": "string", "minLength": 1},
    "evidence_catalog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "results": {"type": "array", "minItems": 48, "maxItems": 48, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "sourceFamily": {
      "enum": [
        "PUBLIC_DETERMINISTIC_TECHNICAL", "MEASUREMENT_GATEWAY", "BROWSER_RENDERING",
        "PERFORMANCE_CWV_LAB", "SEARCH_INDEXING_SERP", "ANALYTICS_SEARCH_CONSOLE",
        "STRUCTURED_CONTENT_DOM_METADATA", "RULE_BASED_QUALITATIVE_OBSERVATION",
        "MANUAL_OR_NON_AUTOMATABLE"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_family", "target_url", "status", "evidence_grade", "digest", "reference", "claim_boundary", "raw_provider_payload_present"],
      "properties": {
        "id": {"type": "string", "pattern": "^E-[0-9]{3,}$"},
        "source_family": {"$ref": "#/$defs/sourceFamily"},
        "target_url": {"type": "string", "pattern": "^https?://"},
        "status": {"enum": ["MEASURED", "OBSERVED", "UNAVAILABLE", "ERROR"]},
        "evidence_grade": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"]},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference": {"type": "string", "minLength": 1},
        "claim_boundary": {"type": "string", "minLength": 1},
        "raw_provider_payload_present": {"const": false}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id", "target_url", "source_family", "execution_state", "evidence_grade",
        "value", "unit", "evidence_refs", "source_or_method", "limitation", "product_status",
        "threshold_source", "confidence", "observed_at", "reason_codes", "note",
        "raw_provider_payload_present"
      ],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[A-Z0-9]+-[0-9]{2}$"},
        "target_url": {"type": "string", "pattern": "^https?://"},
        "source_family": {"$ref": "#/$defs/sourceFamily"},
        "execution_state": {"enum": ["MEASURED", "OBSERVED", "UNAVAILABLE", "ERROR", "CONFLICT", "NOT_APPLICABLE"]},
        "evidence_grade": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"]},
        "value": {"type": ["object", "null"]},
        "unit": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]{3,}$"}},
        "source_or_method": {"type": "string", "minLength": 1},
        "limitation": {"type": "string", "minLength": 1},
        "product_status": {"type": ["string", "null"], "enum": ["strong", "minor_gaps", "mixed", "weak", "blocking", null]},
        "threshold_source": {"type": ["string", "null"]},
        "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
        "observed_at": {"type": ["string", "null"]},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "note": {"type": ["string", "null"]},
        "raw_provider_payload_present": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"execution_state": {"enum": ["MEASURED", "OBSERVED"]}}, "required": ["execution_state"]},
          "then": {
            "properties": {
              "value": {"type": "object"},
              "product_status": {"enum": ["strong", "minor_gaps", "mixed", "weak", "blocking"]},
              "evidence_refs": {"minItems": 1},
              "reason_codes": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "product_status": {"type": "null"},
              "reason_codes": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
