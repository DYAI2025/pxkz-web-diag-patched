{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelkiez.local/schemas/measurement-envelope.schema.json",
  "title": "Pixelkiez Measurement Gateway Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gateway_version", "run_id", "target_url", "execution_mode", "status", "started_at", "completed_at", "observations", "errors", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "gateway_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "target_url": {"type": "string", "pattern": "^https?://"},
    "execution_mode": {"enum": ["LIVE", "FIXTURE"]},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED", "UNAVAILABLE"]},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "status", "value", "unit", "observed_at", "url", "evidence_ref", "claim_boundary", "context"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "adapter": {"type": "string", "minLength": 1},
          "status": {"enum": ["MEASURED", "OBSERVED", "UNAVAILABLE", "ERROR", "NOT_APPLICABLE"]},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "observed_at": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "evidence_ref": {"type": "string", "minLength": 1},
          "claim_boundary": {"type": "string", "minLength": 1},
          "context": {"type": "object"}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "code", "message", "retryable"],
        "properties": {
          "adapter": {"type": "string", "minLength": 1},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "request_policy_version", "response_digests"],
      "properties": {
        "source": {"const": "pixelkiez-measurement-gateway"},
        "request_policy_version": {"type": "string", "minLength": 1},
        "response_digests": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    }
  }
}
