{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pixelkiez Provider-Neutral Website Audit Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_version",
    "audit_id",
    "company",
    "website",
    "audit_date",
    "score_state",
    "limitations",
    "strengths",
    "remediation_priorities",
    "conversation_hooks",
    "source_report_digest"
  ],
  "properties": {
    "packet_version": {
      "const": "1.0"
    },
    "audit_id": {
      "type": "string",
      "minLength": 1
    },
    "company": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "audit_date": {
      "type": "string",
      "minLength": 1
    },
    "score_state": {
      "type": "object",
      "required": [
        "display_status",
        "score",
        "coverage_percent",
        "category_scores"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "remediation_priorities": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "observation",
          "impact",
          "action",
          "confidence"
        ]
      }
    },
    "conversation_hooks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "evidence_class",
          "selector_score",
          "spoken",
          "possible_relevance",
          "prohibited_claims"
        ],
        "properties": {
          "dimension": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              null
            ]
          },
          "observation": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_pointer": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "source_report_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
